{
  "id": "https://gwent.shanaghy.com/sfx.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "description": "Sound effects message",
  "type": "object",
  "required": [
    "subkind",
    "player"
  ],
  "properties": {
    "subkind": {
      "description": "Indicates the content of this message",
      "type": "string",
      "enum": [
        "add_to_deck"
      ]
    },
    "player": {
      "type": "string",
      "description": "The player this card is associated with",
      "enum": [
        "PLAYER.ONE",
        "PLAYER.TWO"
      ]
    },
    "card": {
      "type": "object",
      "description": "The card associated with this event (See card_schema.json)",
      "additionalProperties": true
    }
  }
}
