{
  "id": "https://gwent.shanaghy.com/card_play.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "description": "Card play message",
  "type": "object",
  "required": [
    "subkind",
    "player"
  ],
  "properties": {
    "subkind": {
      "description": "Indicates the content of this message",
      "type": "string",
      "enum": [
        "add_to_deck",
        "deal_to_hand",
        "update_score"
      ]
    },
    "player": {
      "type": "string",
      "description": "The player this event is associated with",
      "enum": [
        "PLAYER.ONE",
        "PLAYER.TWO"
      ]
    },
    "card": {
      "type": "object",
      "description": "The card associated with this event (See card_schema.json)",
      "additionalProperties": true
    },
    "score": {
      "type": "integer",
      "description": "The calculated score for update_score events"
    }
  }
}
