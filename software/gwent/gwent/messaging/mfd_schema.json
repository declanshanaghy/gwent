{
  "id": "https://gwent.shanaghy.com/schema_mfd.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "description": "Multi-funciton display message",
  "type": "object",
  "required": [
    "subkind"
  ],
  "properties": {
    "subkind": {
      "type": "string",
      "description": "Indicates the content of this message",
      "enum": [
        "prompt",
        "error",
        "choices"
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/Prompt" },
    { "$ref": "#/definitions/Error" },
    { "$ref": "#/definitions/Choices" }
  ],
  "definitions": {
    "Prompt": {
      "type": "object",
      "required": ["prompt"],
      "properties": {
        "prompt": {
          "type": "string",
          "description": "An informative prompt to the user"
        },
        "ok": {
          "type": "boolean",
          "default": false,
          "description": "Flag insicating whether to show an OK selection"
        },
        "cancel": {
          "type": "boolean",
          "default": false,
          "description": "Flag insicating whether to show a CANCEL selection"
        },
        "clear_choices": {
          "type": "boolean",
          "default": false,
          "description": "Flag indicating whether to clear out the existing choices"
        }
      }
    },
    "Error": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "prompt": {
          "type": "string",
          "description": "An error message to present to the user"
        }
      }
    },
    "Choices": {
      "type": "object",
      "required": ["choices"],
      "properties": {
        "choices": {
          "type": "array",
          "description": "The choices to be presented to the user",
          "items": {
            "$ref": "#/definitions/choice"
          }
        },
        "clear_prompt": {
          "type": "boolean",
          "default": false,
          "description": "Flag indicating whether to clear the prompt"
        }
      }
    },
    "choice": {
      "type": "object",
      "required": [ "id", "text" ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The id of this choice"
        },
        "text": {
          "type": "string",
          "description": "The text to display for this choice"
        }
      }
    }
  }
}
