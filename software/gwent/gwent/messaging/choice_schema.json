{
  "id": "https://gwent.shanaghy.com/schema_mfd.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "description": "Multi-function display choice",
  "type": "object",
  "$ref": "#/definitions/choice",
  "definitions": {
    "choice": {
      "type": "object",
      "required": [ "id", "text" ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The id of this choice"
        },
        "text": {
          "type": "string",
          "description": "The text to display for this choice"
        }
      }
    }
  }
}
