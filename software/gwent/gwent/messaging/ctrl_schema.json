{
  "id": "https://gwent.shanaghy.com/sfx.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "description": "Sound effects message",
  "type": "object",
  "required": [
    "subkind"
  ],
  "properties": {
    "subkind": {
      "description": "Indicates the content of this message",
      "type": "string",
      "enum": [
        "state"
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/State" }
  ],
  "definitions": {
    "State": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "NewGame"
          ]
        }
      }
    }
  }
}
