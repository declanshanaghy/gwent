{
  "id": "https://gwent.shanaghy.com/sfx.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "description": "Sound effects message",
  "type": "object",
  "required": [
    "subkind"
  ],
  "properties": {
    "subkind": {
      "type": "string",
      "description": "Indicates the content of this message",
      "enum": [
        "announcement",
        "effect",
        "music"
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/Announcement" },
    { "$ref": "#/definitions/Effect" },
    { "$ref": "#/definitions/Music" }
  ],
  "definitions": {
    "Announcement": {
      "type": "object",
      "required": [
        "announcement"
      ],
      "properties": {
        "announcement": {
          "description": "The message to annouce via TTS",
          "type": "string"
        }
      }
    },
    "Effect": {
      "type": "object",
      "required": [
        "effect"
      ],
      "properties": {
        "effect": {
          "description": "The sound effect to play",
          "type": "string"
        }
      }
    },
    "Music": {
      "type": "object",
      "required": [
        "random"
      ],
      "properties": {
        "music": {
          "description": "The music file to play in the background",
          "type": "string"
        },
        "random": {
          "description": "Plays a random background track",
          "type": "boolean"
        }
      }
    }
  }
}
