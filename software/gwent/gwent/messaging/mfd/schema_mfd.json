{
  "id": "https://gwent.shanaghy.com/schema_mfd.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "description": "Multi-funciton display message",
  "type": "object",
  "required": [
    "choices"
  ],
  "properties": {
    "choices": {
      "description": "The choices to be presented to the user",
      "type": "array",
      "items": { "$ref": "#/definitions/choice" }
    }
  },
  "definitions": {
    "choice": {
      "type": "object",
      "required": [ "id", "text" ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The id of this choice"
        },
        "text": {
          "type": "string",
          "description": "The text to display for this choice"
        }
      }
    }
  }
}
