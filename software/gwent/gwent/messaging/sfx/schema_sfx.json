{
  "id": "https://gwent.shanaghy.com/sfx.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "description": "Sound effects message",
  "type": "object",
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "description": "The action requested of the SFX system",
      "type": "string",
      "enum": [
        "announce"
      ]
    },
    "message": {
      "description": "The message to annouce via TTS",
      "type": "string"
    }
  }
}
