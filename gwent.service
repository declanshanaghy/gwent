[Unit]
Description=Gwent Game Service
After=network.target mosquitto.service redis-server.service
Wants=mosquitto.service redis-server.service

[Service]
Type=simple
User=dshanaghy
WorkingDirectory=/home/dshanaghy
Environment=PYTHONUNBUFFERED=1
Environment=RASPBERRY_PI_IP=192.168.1.225
Environment=RUNNING_ON_PI=true
ExecStart=/home/dshanaghy/gwent-venv/bin/gwent
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target